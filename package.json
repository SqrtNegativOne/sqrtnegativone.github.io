{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run blog:build && vite dev",
    "build": "bun run blog:build && vite build",
    "blog:build": "bunx @11ty/eleventy",
    "blog:watch": "bunx @11ty/eleventy --watch",
    "lint": "eslint . && oxlint -c .oxlintrc.json",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo"
  },
  "dependencies": {
    "@fontsource/datatype": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "motion": "^13.1.1",
    "mouse-follower": "^1.2.0",
    "ogl": "^1.0.11",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "culori": "^4.0.2",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "get-google-fonts": "^1.2.2",
    "globals": "^17.11.0",
    "oxlint": "^1.80.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
