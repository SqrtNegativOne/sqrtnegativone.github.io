{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run media:build && npm run blog:build && vite",
    "build": "npm run media:build && npm run blog:build && vite build && node -e \"require('fs').copyFileSync('docs/index.html', 'docs/404.html'); require('fs').writeFileSync('docs/CNAME', 'sqrt.fyi')\"",
    "blog:build": "npx @11ty/eleventy",
    "blog:watch": "npx @11ty/eleventy --watch",
    "media:build": "node scripts/build-media.mjs",
    "lint": "oxlint -c .oxlintrc.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "oxlint": "^1.76.0",
    "svelte": "^5.56.8",
    "vite": "^8.0.1"
  }
}
