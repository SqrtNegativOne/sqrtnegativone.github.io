---
layout: base.njk
bodyClass: no-border
---

<div class="blog-layout is-post">
  <div class="blog-content">
    {% if section == "afterdark" %}
    <a href="/blog-afterdark/" class="post-back">&larr; All afterdark posts</a>
    {% else %}
    <a href="/blog/" class="post-back">&larr; All posts</a>
    {% endif %}

    <article>
      <header class="post-header">
        <h2 class="post-title">{{ title }}</h2>
        {% if description %}
        <p class="post-subtitle">{{ description }}</p>
        {% endif %}
        <time class="post-date">{{ date | readableDate }}</time>
        {% if tags %}
        <div class="post-tags">
          {% for tag in tags %}
            {% if tag != "post" and tag != "afterdark" %}
            <span class="post-tag">#{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </header>
      <div class="post-body">
        {{ content | safe }}
      </div>
    </article>
  </div>
</div>
