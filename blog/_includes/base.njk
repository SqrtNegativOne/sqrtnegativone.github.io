<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title | default("Blog") }} — Ark Malhotra</title>
  <meta name="description" content="{{ description | default("The Blog of Sqrt-1. Nothing particularly special about it.") }}" />
  <meta name="author" content="Ark Malhotra" />
  <link rel="canonical" href="https://sqrt.fyi{{ page.url }}" />
  <link rel="alternate" type="application/atom+xml" title="Ark Malhotra's blog" href="/feed.xml" />
  {% set isPost = bodyClass == "no-border" %}
  {% if isPost %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": date | isoDate,
    "url": "https://sqrt.fyi" + page.url,
    "mainEntityOfPage": "https://sqrt.fyi" + page.url,
    "author": { "@type": "Person", "name": "Ark Malhotra", "url": "https://sqrt.fyi/" }
  } | json | safe }}</script>
  {% else %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "The Blog of Sqrt-1",
    "description": "The Blog of Sqrt-1. Nothing particularly special about it.",
    "url": "https://sqrt.fyi/blog/",
    "author": { "@type": "Person", "name": "Ark Malhotra", "url": "https://sqrt.fyi/" }
  } | json | safe }}</script>
  {% endif %}
  <!-- Open Graph -->
  <meta property="og:type" content="{% if bodyClass == 'no-border' %}article{% else %}website{% endif %}" />
  <meta property="og:url" content="https://sqrt.fyi{{ page.url }}" />
  <meta property="og:title" content="{{ title | default("Blog") }} — Ark Malhotra" />
  <meta property="og:description" content="{{ description | default("The Blog of Sqrt-1. Nothing particularly special about it.") }}" />
  <!--<meta property="og:image" content="https://sqrt.fyi/portraits/portrait.png" />-->
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title | default("Blog") }} — Ark Malhotra" />
  <meta name="twitter:description" content="{{ description | default("The Blog of Sqrt-1. Nothing particularly special about it.") }}" />
  <!--<meta name="twitter:image" content="https://sqrt.fyi/portraits/portrait.png" />-->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link href="/fonts/fonts.css" rel="stylesheet" />
  <script data-goatcounter="https://sqrt.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
  <style>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: oklch(0.9621 0.0074 80.72);
      --text: oklch(0.2178 0 0);
      --text-secondary: oklch(0.4495 0 0);
    }

    [data-theme="dark"] {
      --bg: oklch(0.1638 0 0);
      --text: oklch(0.931 0 0);
      --text-secondary: oklch(0.738 0 0);
    }

    html, body {
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--text);
      color: var(--bg);
    }

    /* ── Viewport border frame ── */
    body::before {
      content: '';
      position: fixed;
      inset: 40px;
      border: 1px solid var(--text);
      opacity: 0.18;
      pointer-events: none;
      z-index: 9999;
      transition: opacity 0.4s ease, inset 0.4s ease;
    }

    body.border-out::before {
      opacity: 0;
      inset: 0;
    }

    /* Post pages: no border */
    body.no-border::before {
      display: none;
    }

    @media (max-width: 640px) {
      body::before { inset: 16px; }
      body.border-out::before { inset: 0; }
    }

    /* ── Blog layout: two-column with vertical divider ── */
    .blog-layout {
      display: flex;
      min-height: 100vh;
      padding: 4rem;
    }

    /* Single post: center content, no side header */
    .blog-layout.is-post {
      justify-content: center;
      padding: 3rem 2rem;
    }

    .blog-layout.is-post .blog-content {
      padding-left: 0;
      padding-top: 0;
      max-width: 640px;
      width: 100%;
      max-height: none;
      overflow-y: visible;
    }

    /* Left panel: "the BLOG" title */
    .blog-header {
      flex-shrink: 0;
      display: flex;
      align-items: flex-end;
      padding-bottom: 2rem;
      padding-right: 3rem;
    }

    .blog-title {
      font-family: "Instrument Serif", serif;
      font-weight: 400;
      font-size: clamp(3rem, 6vw, 5rem);
      line-height: 1;
      color: var(--text);
    }

    .blog-title em {
      font-style: italic;
      font-weight: 400;
    }

    .blog-title span {
      display: block;
      font-style: normal;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .blog-title .afterdark-sub {
      display: block;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.45em;
      font-style: normal;
      text-transform: lowercase;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      margin-top: 0.15em;
    }

    .blog-feed-link {
      display: block;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.7rem;
      font-weight: 300;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      text-decoration: none;
      margin-top: 1rem;
      transition: color 0.2s;
    }

    .blog-feed-link:hover {
      color: var(--text);
    }

    /* Vertical divider */
    .blog-divider {
      flex-shrink: 0;
      width: 1px;
      background: var(--text);
      opacity: 0.18;
      align-self: stretch;
    }

    /* Right panel: content */
    .blog-content {
      flex: 1;
      padding-left: 3rem;
      padding-top: 2rem;
      overflow-y: auto;
      max-height: 100vh;
    }

    /* ── Home link ── */
    .blog-home-link {
      display: inline-block;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.7rem;
      font-weight: 300;
      color: var(--text-secondary);
      text-decoration: none;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 2rem;
      transition: color 0.2s;
    }

    .blog-home-link:hover {
      color: var(--text);
    }

    /* ── Post list ── */
    .post-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .post-list-item a {
      text-decoration: none;
      color: var(--text);
      display: block;
      padding: 1rem 1.2rem;
      border: 1px solid oklch(1 0 0 / 0.08);
      border-radius: 8px;
      transition: background 0.25s, border-color 0.25s;
    }

    [data-theme="dark"] .post-list-item a:hover {
      background: oklch(1 0 0 / 0.04);
      border-color: oklch(1 0 0 / 0.15);
    }

    .post-list-item a:hover {
      background: oklch(0 0 0 / 0.03);
      border-color: oklch(0 0 0 / 0.12);
    }

    .post-list-title {
      font-size: 1rem;
      font-weight: 600;
      margin: 0;
    }

    .post-list-date {
      font-size: 0.75rem;
      color: var(--text-secondary);
      display: block;
      margin-top: 0.25rem;
    }

    .post-list-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin-top: 0.4rem;
    }

    /* ── Single post ── */
    .post-header {
      margin-bottom: 2rem;
    }

    .post-title {
      font-family: "Instrument Serif", serif;
      font-weight: 400;
      font-size: 1.8rem;
      line-height: 1.3;
    }

    .post-date {
      font-size: 0.75rem;
      color: var(--text-secondary);
      display: block;
      margin-top: 0.5rem;
    }

    .post-body {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 520px;
    }

    .post-body p,
    .post-body li {
      font-size: 0.9rem;
      line-height: 1.7;
    }

    .post-body ul,
    .post-body ol {
      padding-left: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin: 0.5rem 0;
    }

    .post-body img {
      max-width: 100%;
      height: auto;
      border-radius: 6px;
    }

    .post-body a {
      color: var(--text);
      text-decoration: underline;
      text-decoration-color: var(--text-secondary);
      text-underline-offset: 3px;
      transition: text-decoration-color 0.2s;
    }

    .post-body a:hover {
      text-decoration-color: var(--text);
    }

    .post-body del {
      opacity: 0.5;
    }

    .post-body blockquote {
      border-left: 2px solid var(--text-secondary);
      padding-left: 1.2rem;
      margin: 0.5rem 0;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .post-body blockquote p {
      font-style: italic;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .post-body strong {
      font-weight: 700;
    }

    .post-back {
      display: inline-block;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.75rem;
      color: var(--text-secondary);
      text-decoration: none;
      margin-bottom: 1.5rem;
      transition: color 0.2s;
    }

    .post-back:hover {
      color: var(--text);
    }

    /* ── Afterdark badge ── */
    .afterdark-badge {
      display: inline-block;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-secondary);
      border: 1px solid var(--text-secondary);
      border-radius: 3px;
      padding: 0.15rem 0.5rem;
      margin-bottom: 1.5rem;
      opacity: 0.6;
    }

    /* ── Footnotes ── */
    .footnotes {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid oklch(0.5999 0 0 / 0.2);
      font-size: 0.78rem;
      color: var(--text-secondary);
    }

    .footnotes ol {
      padding-left: 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .footnotes li {
      line-height: 1.6;
    }

    /* Inline footnote reference superscript */
    .footnote-ref {
      line-height: 0;
    }
    
    .footnote-ref a {
      font-size: 0.75rem;
      color: var(--text-secondary);
      text-decoration: none;
      vertical-align: super;
      line-height: 0;
      font-weight: 300;
      transition: color 0.2s;
    }

    .footnote-ref a:hover {
      color: var(--text);
    }

    /* Back-reference arrow */
    .footnote-backref {
      font-size: 0.7rem;
      text-decoration: none;
      color: var(--text-secondary);
      margin-left: 0.3em;
      transition: color 0.2s;
    }

    .footnote-backref:hover {
      color: var(--text);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .blog-layout {
        flex-direction: column;
        padding: 2rem 1.5rem;
      }

      .blog-header {
        padding: 0 0 1.5rem 0;
        align-items: flex-start;
      }

      .blog-title {
        font-size: 2.5rem;
      }

      .blog-divider {
        width: 100%;
        height: 1px;
        align-self: auto;
      }

      .blog-content {
        padding: 1.5rem 0 0 0;
        max-height: none;
      }
    }

    {% for f in fonts %}
    {% if font == f.name %}
    .post-body { {{ f.css | safe }} }
    {% endif %}
    {% endfor %}
  </style>
</head>
<body class="{{ bodyClass }}">
  <div class="blog-layout{% if isPost %} is-post{% endif %}">
    {% if not isPost %}
    <header class="blog-header">
      <h1 class="blog-title">
        <em>the</em>
        <span>BLOG</span>
        {% if isAfterdark %}<span class="afterdark-sub">afterdark</span>{% endif %}
      </h1>
      <a class="blog-feed-link" href="/feed.xml" type="application/atom+xml">atom feed</a>
    </header>

    <div class="blog-divider"></div>
    {% endif %}

    <div class="blog-content">
      {% if not isPost %}
      <a href="/" class="blog-home-link">&larr; Back to site</a>
      {% endif %}
      {{ content | safe }}
    </div>
  </div>

  {% if not bodyClass %}
  {# Listing pages: animate border out when clicking a post link #}
  <script>
    document.querySelectorAll('.post-list-item a').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var href = this.href;
        document.body.classList.add('border-out');
        setTimeout(function() {
          window.location.href = href;
        }, 400);
      });
    });
  </script>
  {% endif %}
</body>
</html>
