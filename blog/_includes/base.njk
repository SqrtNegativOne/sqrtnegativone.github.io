<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title | default("Blog") }} — Ark Malhotra</title>
  <meta name="description" content="{{ description | default("The Blog of Sqrt-1. Nothing particularly special about it.") }}" />
  <meta name="author" content="Ark Malhotra" />
  <link rel="canonical" href="https://sqrt.fyi{{ page.url }}" />
  <link rel="alternate" type="application/atom+xml" title="Ark Malhotra's blog" href="/feed.xml" />
  {% set isPost = bodyClass == "no-border" %}
  {% if isPost %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": date | isoDate,
    "url": "https://sqrt.fyi" + page.url,
    "mainEntityOfPage": "https://sqrt.fyi" + page.url,
    "author": { "@type": "Person", "name": "Ark Malhotra", "url": "https://sqrt.fyi/" }
  } | json | safe }}</script>
  {% else %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "The Blog of Sqrt-1",
    "description": "The Blog of Sqrt-1. Nothing particularly special about it.",
    "url": "https://sqrt.fyi/blog/",
    "author": { "@type": "Person", "name": "Ark Malhotra", "url": "https://sqrt.fyi/" }
  } | json | safe }}</script>
  {% endif %}
  <!-- Open Graph -->
  <meta property="og:type" content="{% if bodyClass == 'no-border' %}article{% else %}website{% endif %}" />
  <meta property="og:url" content="https://sqrt.fyi{{ page.url }}" />
  <meta property="og:title" content="{{ title | default("Blog") }} — Ark Malhotra" />
  <meta property="og:description" content="{{ description | default("The Blog of Sqrt-1. Nothing particularly special about it.") }}" />
  <!--<meta property="og:image" content="https://sqrt.fyi/portraits/portrait.png" />-->
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title | default("Blog") }} — Ark Malhotra" />
  <meta name="twitter:description" content="{{ description | default("The Blog of Sqrt-1. Nothing particularly special about it.") }}" />
  <!--<meta name="twitter:image" content="https://sqrt.fyi/portraits/portrait.png" />-->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link href="/fonts/fonts.css" rel="stylesheet" />
  <script data-goatcounter="https://sqrt.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
  <style>
    {% include "css/base.css" %}
    {% if not isPost %}
    {% include "css/index.css" %}
    {% else %}
    {% include "css/post.css" %}
    {% endif %}

    {% for f in fonts %}
    {% if font == f.name %}
    .post-body { {{ f.css | safe }} }
    {% endif %}
    {% endfor %}
  </style>
</head>
<body class="{{ bodyClass }}">
  {{ content | safe }}
</body>
</html>
